# ============================================================================
# OAuth GitHub - Configuration Example
# ============================================================================
# Copy file này thành `.env` (cùng thư mục với admin/app.py) và điền giá trị
# thật. KHÔNG commit `.env` lên git (đã add vào .gitignore).
#
# Bước 1: Đăng ký GitHub OAuth App
#   - Mở https://github.com/settings/developers
#   - Tab "OAuth Apps" → "New OAuth App"
#   - Application name:    3105-repo-builder
#   - Homepage URL:        http://127.0.0.1:5050
#   - Authorization callback URL:  http://127.0.0.1:5050/auth/github/callback
#   - Tick "Enable Device Flow" nếu muốn dùng cho CLI
#   - Bấm "Register application"
#   - Copy "Client ID" vào GITHUB_CLIENT_ID
#   - Bấm "Generate a new client secret" → copy vào GITHUB_CLIENT_SECRET
#
# Bước 2: Generate SECRET_KEY cho Flask session
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Bước 3: Tạo file .env từ .env.example
#   cp .env.example .env  (hoặc copy thủ công trên Windows)
#   Sửa giá trị trong .env
#
# ============================================================================

# GitHub OAuth App credentials (BẮT BUỘC)
GITHUB_CLIENT_ID=Iv1.replace_with_your_client_id
GITHUB_CLIENT_SECRET=replace_with_your_client_secret

# Flask session secret (BẮT BUỘC - generate bằng secrets.token_urlsafe(32))
SECRET_KEY=replace_with_random_64_char_string

# OAuth callback URL (KHỚP với "Authorization callback URL" trên GitHub)
# Dev:    http://127.0.0.1:5050/auth/github/callback
# Prod:   https://your-domain.com/auth/github/callback
OAUTH_CALLBACK_URL=http://127.0.0.1:5050/auth/github/callback

# GitHub API base (KHÔNG CẦN SỬA)
GITHUB_API_BASE=https://api.github.com

# Personal Access Token cho READ-ONLY requests (TÙY CHỌN nhưng KHUYẾN NGHỊ).
# Tăng rate limit từ 60/hr (unauthenticated) lên 5000/hr (authenticated).
# Tạo PAT: https://github.com/settings/tokens/new
#   - Chọn "No scopes" (chỉ cần public read) HOẶC tick "public_repo" nếu muốn
#     sau này push qua token (khuyến nghị cho admin thường xuyên build).
# Dùng cho các public API: /api/public/admin-settings, /api/fetch-repo-json,
# /api/public/raw-asset, /api/public/release — KHÔNG cần user OAuth login.
GITHUB_PAT=ghp_replace_with_your_personal_access_token

# Front-end base URL để redirect sau khi login (KHỚP với deployment)
FRONTEND_BASE_URL=http://127.0.0.1:5050

# Cache TTL cho repo discovery (giây)
REPO_DISCOVERY_CACHE_TTL=300
